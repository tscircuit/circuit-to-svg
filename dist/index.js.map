{
  "name": "circuit-to-svg",
  "type": "module",
  "version": "0.0.436",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/circuit-to-svg.git"
  },
  "description": "Convert Circuit JSON to SVG",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "cosmos",
    "prepublish": "npm run build",
    "prepare": "node scripts/prepare-git.cjs",
    "build": "tsup-node ./lib/index.ts --format esm --dts --sourcemap --external tscircuit",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "cosmos": "cosmos",
    "cosmos-export": "cosmos-export"
  },
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tscircuit/alphabet": "^0.0.27",
    "@tscircuit/checks-latest": "npm:@tscircuit/checks@0.0.179",
    "@types/bun": "^1.2.8",
    "@types/debug": "^4.1.12",
    "@vitejs/plugin-react": "5.0.0",
    "biome": "^0.3.3",
    "bun-match-svg": "^0.0.12",
    "esbuild": "^0.20.2",
    "format-si-unit": "^0.0.12",
    "performance-now": "^2.1.0",
    "react": "19.1.0",
    "react-cosmos": "7.0.0",
    "react-cosmos-plugin-vite": "7.0.0",
    "react-dom": "19.1.0",
    "tscircuit": "^0.0.2629",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "peerDependencies": {
    "@tscircuit/alphabet": "*"
  },
  "dependencies": {
    "@tscircuit/circuit-json-util": "^0.0.115",
    "@types/node": "^22.5.5",
    "bun-types": "^1.1.40",
    "calculate-elbow": "0.0.12",
    "circuit-json": "^0.0.501",
    "circuit-json-to-connectivity-map": "^0.0.23",
    "debug": "^4.4.3",
    "schematic-symbols": "^0.0.246",
    "svg-path-commander": "^2.1.11",
    "svgson": "^5.3.1",
    "transformation-matrix": "^2.16.1"
  }
}
